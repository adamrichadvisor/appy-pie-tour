# Copy to .env and fill in your CCAvenue merchant credentials.
# Get these from the CCAvenue merchant dashboard (Settings > API Keys).
# NEVER commit real keys or expose them to the browser.

CCA_MERCHANT_ID=YOUR_MERCHANT_ID
CCA_ACCESS_CODE=YOUR_ACCESS_CODE
CCA_WORKING_KEY=YOUR_32_CHAR_WORKING_KEY

# "test" uses test.ccavenue.com, "prod" uses secure.ccavenue.com
CCA_MODE=test

# Public URL where this server is reachable (used for CCAvenue callbacks)
BASE_URL=http://localhost:3000
PORT=3000
